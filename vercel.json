{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/recipe-calculator",
      "destination": "https://recipe-calculator-liart.vercel.app/recipe-calculator"
    },
    {
      "source": "/recipe-calculator/:path*",
      "destination": "https://recipe-calculator-liart.vercel.app/recipe-calculator/:path*"
    },
    {
      "source": "/zubora-recipe",
      "destination": "https://zubora-recipe.vercel.app/zubora-recipe"
    },
    {
      "source": "/zubora-recipe/:path*",
      "destination": "https://zubora-recipe.vercel.app/zubora-recipe/:path*"
    },
    {
      "source": "/fashion-weather",
      "destination": "https://fashion-weather-topaz.vercel.app/fashion-weather"
    },
    {
      "source": "/fashion-weather/:path*",
      "destination": "https://fashion-weather-topaz.vercel.app/fashion-weather/:path*"
    },
    {
      "source": "/travel-checklist",
      "destination": "https://travel-checklist2.vercel.app/travel-checklist"
    },
    {
      "source": "/travel-checklist/:match*",
      "destination": "https://travel-checklist2.vercel.app/travel-checklist/:match*"
    },
    {
      "source": "/calcnote",
      "destination": "https://calcnote-app.vercel.app/calcnote"
